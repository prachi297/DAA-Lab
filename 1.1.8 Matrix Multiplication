#include <stdio.h>
#include <stdlib.h>

int main() {
    int m, n;
    // 1. Read dimensions of matrix A
    if (scanf("%d %d", &m, &n) != 2) return 0;

    // Allocate and read matrix A
    int **A = (int **)malloc(m * sizeof(int *));
    for (int i = 0; i < m; i++) {
        A[i] = (int *)malloc(n * sizeof(int));
        for (int j = 0; j < n; j++) {
            if (scanf("%d", &A[i][j]) != 1) return 0;
        }
    }

    int r_B, p;
    // 2. Read dimensions of matrix B
    if (scanf("%d %d", &r_B, &p) != 2) return 0;
    // 3. Check compatibility: columns of A must equal rows of B
    if (n != r_B) {
        printf("Invalid input\n");
        
        // Free allocated memory for A before exiting
        for (int i = 0; i < m; i++) free(A[i]);
        free(A);
        return 0;
    }

    // 4. Read matrix B since dimensions are valid
    int **B = (int **)malloc(r_B * sizeof(int *));
    for (int i = 0; i < r_B; i++) {
        B[i] = (int *)malloc(p * sizeof(int));
        for (int j = 0; j < p; j++) {
            if (scanf("%d", &B[i][j]) != 1) return 0;
        }
    }

    // 5. Initialize result matrix C with zeros
    int **C = (int **)malloc(m * sizeof(int *));
    for (int i = 0; i < m; i++) {
        C[i] = (int *)calloc(p, sizeof(int));
    }

    // 6. Perform matrix multiplication
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < p; j++) {
            for (int k = 0; k < n; k++) {
                C[i][j] += A[i][k] * B[k][j];
            }
        }
    }

    // 7. Print the resulting matrix
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < p; j++) {
            printf("%d ", C[i][j]);
            if (j < p - 1) {
                printf("");
            }
        }
        printf("\n");
    }

    // Free all dynamically allocated memory
    for (int i = 0; i < m; i++) free(A[i]);
    free(A);
    for (int i = 0; i < r_B; i++) free(B[i]);
    free(B);
    for (int i = 0; i < m; i++) free(C[i]);
    free(C);

    return 0;
}

