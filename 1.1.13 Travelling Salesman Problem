#include <stdio.h>
#include <limits.h>

#define INF 1000000000

int main() {
    int n;
    scanf("%d", &n);

    int cost[n][n];

    // Read cost matrix
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &cost[i][j]);

            // -1 means no direct connection
            if (cost[i][j] == -1) {
                cost[i][j] = INF;
            }
        }
    }

    int totalMasks = 1 << n;

    // dp[mask][i]:
    // Minimum cost to visit all cities in mask
    // and end at city i
    int dp[totalMasks][n];

    // Initialize DP table
    for (int mask = 0; mask < totalMasks; mask++) {
        for (int i = 0; i < n; i++) {
            dp[mask][i] = INF;
        }
    }

    // Start from city 0
    dp[1][0] = 0;

    // Iterate through all subsets
    for (int mask = 1; mask < totalMasks; mask++) {

        for (int u = 0; u < n; u++) {

            // u must be visited
            if (!(mask & (1 << u)))
                continue;

            if (dp[mask][u] == INF)
                continue;

            // Try visiting an unvisited city
            for (int v = 0; v < n; v++) {

                // v is already visited
                if (mask & (1 << v))
                    continue;

                // No path from u to v
                if (cost[u][v] == INF)
                    continue;

                int newMask = mask | (1 << v);

                int newCost = dp[mask][u] + cost[u][v];

                if (newCost < dp[newMask][v]) {
                    dp[newMask][v] = newCost;
                }
            }
        }
    }

    // All cities visited
    int fullMask = totalMasks - 1;

    int answer = INF;

    // Return from last city to starting city 0
    for (int i = 1; i < n; i++) {

        if (dp[fullMask][i] == INF)
            continue;

        if (cost[i][0] == INF)
            continue;

        int tourCost = dp[fullMask][i] + cost[i][0];

        if (tourCost < answer) {
            answer = tourCost;
        }
    }

    printf("%d\n", answer);

    return 0;
}

